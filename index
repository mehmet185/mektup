<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Affet Beni...</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Dancing+Script:wght@500&family=Special+Elite&display=swap" rel="stylesheet">
<style>
:root {
  --bg-deep: #0f0a1e;
  --bg-mid: #1a1030;
  --candle: #ffb347;
  --rose: #c94f6d;
  --tear: #a8b5d9;
  --paper: #f4ecd8;
  --ink: #2a1a3a;
  --yes-green: #4ade80;
  --no-red: #ef4444;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Cormorant Garamond', serif;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-mid) 50%, #2a1840 100%);
  color: #e8dcff;
  overflow-x: hidden;
  min-height: 100vh;
  position: relative;
}

.rain { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
.drop { position: absolute; top: -10%; width: 1px; height: 15px; background: linear-gradient(transparent, rgba(168, 181, 217, 0.6)); animation: fall linear infinite; }
@keyframes fall { to { transform: translateY(110vh); } }

.stars { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
.star { position: absolute; background: white; border-radius: 50%; animation: twinkle 3s infinite; }
@keyframes twinkle { 0%, 100% { opacity: 0.2; } 50% { opacity: 1; } }

.container { position: relative; z-index: 10; max-width: 900px; margin: 0 auto; padding: 60px 25px; }

.hero { text-align: center; padding: 80px 20px 60px; animation: fadeInSlow 3s ease-out; }
@keyframes fadeInSlow { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.hero h1 { font-family: 'Dancing Script', cursive; font-size: clamp(3rem, 8vw, 5.5rem); color: var(--candle); text-shadow: 0 0 30px rgba(255, 179, 71, 0.4); margin-bottom: 20px; letter-spacing: 2px; }
.hero .whisper { font-style: italic; font-size: 1.3rem; color: var(--tear); opacity: 0.8; letter-spacing: 1px; }
.divider { width: 60px; height: 1px; background: var(--candle); margin: 40px auto; position: relative; }
.divider::before { content: '✦'; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); color: var(--candle); background: var(--bg-mid); padding: 0 10px; font-size: 0.8rem; }

.section-title { font-family: 'Dancing Script', cursive; font-size: 2.5rem; text-align: center; color: var(--candle); margin-bottom: 40px; text-shadow: 0 0 20px rgba(255, 179, 71, 0.3); animation: flicker 4s infinite; }
@keyframes flicker { 0%, 100% { opacity: 1; } 45% { opacity: 0.9; } 50% { opacity: 0.7; } 55% { opacity: 1; } }

.confession { background: rgba(20, 10, 40, 0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255, 179, 71, 0.2); border-radius: 15px; padding: 50px 40px; margin: 60px 0; text-align: center; position: relative; }
.confession::before { content: '"'; position: absolute; top: 10px; left: 20px; font-size: 5rem; color: var(--rose); opacity: 0.3; font-family: serif; }
.confession p { font-size: 1.4rem; line-height: 1.8; font-style: italic; color: #e8dcff; min-height: 3em; }

.gallery-section { margin: 80px 0; }
.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-top: 30px; }
.photo-frame { aspect-ratio: 1; background: rgba(244, 236, 216, 0.05); border: 2px solid rgba(255, 179, 71, 0.3); border-radius: 8px; overflow: hidden; position: relative; cursor: pointer; transition: all 0.5s; box-shadow: 0 8px 20px rgba(0,0,0,0.4); }
.photo-frame:hover { transform: translateY(-5px) rotate(-1deg); border-color: var(--candle); box-shadow: 0 15px 35px rgba(255, 179, 71, 0.3); }
.photo-frame img { width: 100%; height: 100%; object-fit: cover; filter: sepia(0.3) brightness(0.9); transition: filter 0.5s; }
.photo-frame:hover img { filter: sepia(0) brightness(1.1); }
.photo-caption { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(15, 10, 30, 0.95)); padding: 30px 15px 15px; font-style: italic; font-size: 0.95rem; color: var(--candle); opacity: 0; transition: opacity 0.4s; }
.photo-frame:hover .photo-caption { opacity: 1; }

.letter-section { margin: 100px 0; perspective: 1500px; }
.letter-paper { background: var(--paper); color: var(--ink); padding: 60px 50px; border-radius: 5px; position: relative; box-shadow: 0 30px 60px rgba(0,0,0,0.5), inset 0 0 100px rgba(139, 90, 50, 0.1); background-image: repeating-linear-gradient(transparent, transparent 28px, rgba(139, 90, 50, 0.1) 29px); transform: rotate(-1deg); font-family: 'Special Elite', cursive; line-height: 1.8; }
.letter-paper::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 30%, rgba(139, 90, 50, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(139, 90, 50, 0.08) 0%, transparent 50%); pointer-events: none; }
.letter-date { text-align: right; font-style: italic; color: #8b5a32; margin-bottom: 20px; }
.letter-paper h3 { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: #5a3a22; margin-bottom: 25px; }
.letter-paper p { font-size: 1.15rem; margin-bottom: 15px; color: var(--ink); }
.letter-paper .signature { text-align: right; font-family: 'Dancing Script', cursive; font-size: 1.8rem; color: var(--rose); margin-top: 30px; }
.tear-stain { position: absolute; width: 80px; height: 80px; background: radial-gradient(circle, rgba(168, 181, 217, 0.3) 0%, transparent 70%); border-radius: 50%; bottom: 100px; right: 80px; pointer-events: none; }

.forgive-section { text-align: center; margin: 80px 0 100px; position: relative; min-height: 300px; }
.question-text { font-family: 'Dancing Script', cursive; font-size: 3rem; color: var(--candle); text-shadow: 0 0 30px rgba(255, 179, 71, 0.5); margin-bottom: 50px; animation: flicker 4s infinite; }
.buttons-container { display: flex; justify-content: center; align-items: center; gap: 40px; flex-wrap: wrap; min-height: 200px; }
.yes-btn { background: linear-gradient(135deg, var(--yes-green), #22c55e); color: white; border: none; padding: 20px 50px; font-size: 1.5rem; font-family: 'Dancing Script', cursive; letter-spacing: 2px; border-radius: 50px; cursor: pointer; box-shadow: 0 10px 30px rgba(74, 222, 128, 0.4); transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); font-weight: bold; }
.yes-btn:hover { transform: scale(1.1); box-shadow: 0 15px 40px rgba(74, 222, 128, 0.6); }
.no-btn { background: linear-gradient(135deg, var(--no-red), #b91c1c); color: white; border: none; padding: 18px 45px; font-size: 1.3rem; font-family: 'Dancing Script', cursive; letter-spacing: 2px; border-radius: 50px; cursor: pointer; box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3); transition: all 0.3s; font-weight: bold; position: relative; user-select: none; }
.no-btn.floating { position: fixed; z-index: 9999; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
.reaction-text { font-style: italic; font-size: 1.3rem; color: var(--tear); min-height: 40px; margin-top: 30px; transition: all 0.3s; }
.no-counter { font-size: 0.95rem; color: rgba(232, 220, 255, 0.6); margin-top: 15px; }
.forgive-message { display: none; margin-top: 40px; padding: 40px; background: rgba(74, 222, 128, 0.1); border: 2px solid var(--yes-green); border-radius: 15px; font-size: 1.4rem; font-style: italic; color: #e8dcff; animation: heartBeat 1s; }
@keyframes heartBeat { 0%, 100% { transform: scale(1); } 25% { transform: scale(1.05); } 50% { transform: scale(1); } 75% { transform: scale(1.03); } }

.falling-heart { position: fixed; font-size: 1.5rem; color: var(--rose); pointer-events: none; z-index: 999; animation: heartFall 4s linear forwards; }
@keyframes heartFall { 0% { transform: translateY(-100px) rotate(0deg); opacity: 1; } 100% { transform: translateY(110vh) rotate(720deg); opacity: 0; } }

.lightbox { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 3000; justify-content: center; align-items: center; cursor: pointer; }
.lightbox.active { display: flex; }
.lightbox img { max-width: 90%; max-height: 90%; border: 3px solid var(--candle); box-shadow: 0 0 50px rgba(255, 179, 71, 0.3); }

.celebrate-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at center, rgba(74, 222, 128, 0.2), transparent 70%); pointer-events: none; z-index: 998; opacity: 0; transition: opacity 1s; }
.celebrate-bg.active { opacity: 1; }

.music-toggle {
  position: fixed;
  bottom: 25px;
  right: 25px;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(255, 179, 71, 0.15);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 179, 71, 0.4);
  color: var(--candle);
  cursor: pointer;
  font-size: 1.3rem;
  z-index: 1000;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 5px 20px rgba(0,0,0,0.3);
}
.music-toggle:hover { background: rgba(255, 179, 71, 0.3); transform: scale(1.1); }
.music-toggle.playing { animation: spin 6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

#youtubePlayer {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

@media (max-width: 600px) {
  .letter-paper { padding: 40px 25px; }
  .confession { padding: 35px 25px; }
  .hero h1 { font-size: 3rem; }
  .question-text { font-size: 2.2rem; }
  .buttons-container { gap: 20px; }
  .music-toggle { bottom: 15px; right: 15px; width: 45px; height: 45px; font-size: 1.1rem; }
}
</style>
</head>
<body>

<div class="stars" id="stars"></div>
<div class="rain" id="rain"></div>
<div class="celebrate-bg" id="celebrateBg"></div>

<button class="music-toggle" id="musicToggle" title="Müziği Durdur/Başlat">🎵</button>
<div id="youtubePlayer"></div>

<div class="container">

  <section class="hero">
    <h1>Affet Beni...</h1>
    <p class="whisper">Sana söylemem gereken şeyler var</p>
    <div class="divider"></div>
  </section>

  <section class="confession">
    <p id="confession-text"></p>
  </section>

  <section class="gallery-section">
    <h2 class="section-title">Bizim Anılarımız</h2>
    <p style="text-align:center; font-style:italic; color:var(--tear); margin-bottom: 10px;">
      Her karede sen varsın, her gülüşte sen... Bu anılar, pişmanlığımın en sessiz tanıkları.
    </p>
    <div class="gallery" id="gallery">
      <!-- FOTOĞRAFLAR BURAYA GELECEK -->
    </div>
  </section>

  <section class="letter-section">
    <h2 class="section-title">Sana Yazdıklarım</h2>
    <div class="letter-paper">
      <div class="letter-date">Bugünün gecesinde...</div>
      <h3>Canım Sevgilim,</h3>
      <p>Bu satırları yazarken ellerim titriyor. Biliyorum, kelimeler bazen yetersiz kalır, ama kalbimdekileri sana anlatmak zorundayım. Seni kırdım, bunu biliyorum ve bunun ağırlığını her nefeste hissediyorum.</p>
      <p>O an düşündüm ki; sen benim hayatımdaki en güzel şeysin. Ve ben, en güzel şeye zarar verdim. Pişmanlığım kelimelerle anlatılamayacak kadar derin. Keşke zamanı geriye sarabilsem, keşke o anı yaşamasak...</p>
      <p>Ama inan bana; bu pişmanlık, seni ne kadar çok sevdiğimin en dürüst kanıtı. Sensiz geçen her saniye, bana sensizliğin ne kadar imkânsız olduğunu hatırlatıyor. Seni seviyorum, hem de her zamankinden daha çok.</p>
      <div class="tear-stain"></div>
      <p class="signature">Pişman olan senin sevgilin ❤</p>
    </div>
  </section>

  <section class="forgive-section">
    <h2 class="question-text">Beni affedecek misin? 🥺</h2>
    
    <div class="buttons-container">
      <button class="yes-btn" id="yesBtn" onclick="sayYes()">Evet ❤</button>
      <button class="no-btn" id="noBtn" onclick="sayNo()">Hayır</button>
    </div>
    
    <p class="reaction-text" id="reactionText"></p>
    <p class="no-counter" id="noCounter"></p>
    
    <div class="forgive-message" id="forgiveMessage">
      Teşekkür ederim... ❤ Bu dünyanın bana verebileceği en güzel hediye, senin kalbin. Sana söz veriyorum; bir daha asla seni üzmeyeceğim. Seni sonsuza kadar seveceğim. 🥹💕
    </div>
  </section>

</div>

<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <img id="lightbox-img" src="" alt="">
</div>

<script>
  var tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  var firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

  var player;
  var isPlaying = false;
  var musicToggle = document.getElementById('musicToggle');

  function onYouTubeIframeAPIReady() {
    player = new YT.Player('youtubePlayer', {
      height: '1',
      width: '1',
      videoId: '5tpQaCAq6Qc',
      playerVars: {
        'autoplay': 1,
        'controls': 0,
        'loop': 1,
        'playlist': '5tpQaCAq6Qc',
        'mute': 0,
        'playsinline': 1
      },
      events: {
        'onReady': onPlayerReady,
        'onStateChange': onPlayerStateChange
      }
    });
  }

  function onPlayerReady(event) {
    event.target.setVolume(60);
    try {
      event.target.playVideo();
      isPlaying = true;
      musicToggle.classList.add('playing');
    } catch(e) {
      event.target.mute();
      event.target.playVideo();
      isPlaying = true;
      musicToggle.classList.add('playing');
    }
  }

  function onPlayerStateChange(event) {
    if (event.data == YT.PlayerState.ENDED) {
      player.playVideo();
    }
  }

  musicToggle.addEventListener('click', () => {
    if (!player) return;
    if (isPlaying) {
      player.pauseVideo();
      musicToggle.classList.remove('playing');
      musicToggle.textContent = '🔇';
      isPlaying = false;
    } else {
      player.playVideo();
      player.unMute();
      player.setVolume(60);
      musicToggle.classList.add('playing');
      musicToggle.textContent = '🎵';
      isPlaying = true;
    }
  });

  document.addEventListener('click', () => {
    if (player && player.unMute) {
      try {
        player.unMute();
        player.setVolume(60);
        if (!isPlaying) {
          player.playVideo();
          isPlaying = true;
          musicToggle.classList.add('playing');
          musicToggle.textContent = '🎵';
        }
      } catch(e) {}
    }
  }, { once: true });
</script>

<script>
const rainContainer = document.getElementById('rain');
for (let i = 0; i < 80; i++) {
  const drop = document.createElement('div');
  drop.className = 'drop';
  drop.style.left = Math.random() * 100 + '%';
  drop.style.animationDuration = (Math.random() * 1 + 0.5) + 's';
  drop.style.animationDelay = Math.random() * 2 + 's';
  drop.style.opacity = Math.random() * 0.5 + 0.2;
  rainContainer.appendChild(drop);
}

const starsContainer = document.getElementById('stars');
for (let i = 0; i < 60; i++) {
  const star = document.createElement('div');
  star.className = 'star';
  const size = Math.random() * 2 + 1;
  star.style.width = size + 'px';
  star.style.height = size + 'px';
  star.style.left = Math.random() * 100 + '%';
  star.style.top = Math.random() * 100 + '%';
  star.style.animationDelay = Math.random() * 3 + 's';
  starsContainer.appendChild(star);
}

const confessionText = "Bazen insan en çok sevdiğini en çok üzer... Ve ben, bunun en acı örneğiyim. Sana yaşattığım her anlık burukluk için, kalbimin en derin köşesinden özür diliyorum.";
const confessionEl = document.getElementById('confession-text');
let charIndex = 0;

function typeWriter(text) {
  if (charIndex < text.length) {
    confessionEl.textContent += text.charAt(charIndex);
    charIndex++;
    setTimeout(() => typeWriter(text), 50);
  }
}
setTimeout(() => typeWriter(confessionText), 1500);

function openLightbox(src) {
  document.getElementById('lightbox-img').src = src;
  document.getElementById('lightbox').classList.add('active');
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
}

let noCount = 0;
let yesScale = 1;
const noBtn = document.getElementById('noBtn');
const yesBtn = document.getElementById('yesBtn');
const reactionText = document.getElementById('reactionText');
const noCounter = document.getElementById('noCounter');

const reactions = [
  "Emin misin? 🥺",
  "Yanlış butona bastın galiba... 😅",
  "Bir daha düşün, lütfen... 💭",
  "Kalbimi kırıyorsun... 💔",
  "Ama ben seni çok seviyorum... 😭",
  "Evet butonu seni bekliyor, gör onu! 👀",
  "Hayır butonundan vazgeç artık... 😩",
  "Lütfennnn... 🥺💕",
  "Gözlerim yaşardı... 😢",
  "Son şansın, artık kabul et! 😭❤",
  "Hayır butonu yoruldu, evet de artık! 😅",
  "Neredeyse tüm ekranı kapladı, acı bana... 🥹"
];

function sayNo() {
  noCount++;
  const reactionIndex = Math.min(noCount - 1, reactions.length - 1);
  reactionText.textContent = reactions[reactionIndex];
  noCounter.textContent = `${noCount}. kez "Hayır" dedin... 💔`;
  yesScale *= 1.25;
  yesBtn.style.transform = `scale(${yesScale})`;
  if (noCount === 3) yesBtn.innerHTML = "Evet, affettim! ❤";
  if (noCount === 5) yesBtn.innerHTML = "EVET! ❤❤";
  if (noCount === 8) yesBtn.innerHTML = "ÇOKTAN EVET! ❤❤❤";
  if (noCount === 10) yesBtn.innerHTML = "ARTIK EVET DE! 💕💕💕";
  noBtn.classList.add('floating');
  moveNoButton();
}

function moveNoButton() {
  const btnWidth = noBtn.offsetWidth;
  const btnHeight = noBtn.offsetHeight;
  const padding = 20;
  const maxX = window.innerWidth - btnWidth - padding;
  const maxY = window.innerHeight - btnHeight - padding;
  const randomX = Math.random() * maxX + padding / 2;
  const randomY = Math.random() * maxY + padding / 2;
  noBtn.style.left = randomX + 'px';
  noBtn.style.top = randomY + 'px';
  const rotation = (Math.random() - 0.5) * 30;
  const currentScale = Math.max(0.5, 1 - noCount * 0.05);
  noBtn.style.transform = `scale(${currentScale}) rotate(${rotation}deg)`;
}

noBtn.addEventListener('mouseenter', () => { if (noCount > 0) moveNoButton(); });
noBtn.addEventListener('touchstart', (e) => { if (noCount > 0) { e.preventDefault(); moveNoButton(); } });

function sayYes() {
  noBtn.style.display = 'none';
  document.getElementById('forgiveMessage').style.display = 'block';
  document.querySelector('.question-text').textContent = "Çok teşekkür ederim! 🥹❤";
  reactionText.textContent = noCount > 0 ? `${noCount} hayırdan sonra sonunda evet dedin! 💕` : "İlk seferde evet! Çok mutlusun! 🥰";
  noCounter.style.display = 'none';
  document.getElementById('celebrateBg').classList.add('active');
  for (let i = 0; i < 60; i++) {
    setTimeout(() => {
      const heart = document.createElement('div');
      heart.className = 'falling-heart';
      heart.textContent = ['❤','💕','💖','💗','💘','💝','💞'][Math.floor(Math.random()*7)];
      heart.style.left = Math.random() * 100 + 'vw';
      heart.style.animationDuration = (Math.random() * 2 + 3) + 's';
      heart.style.fontSize = (Math.random() * 2 + 1.5) + 'rem';
      heart.style.color = ['#c94f6d', '#ff6b9d', '#ff8da1', '#4ade80', '#ffb347'][Math.floor(Math.random()*5)];
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), 5000);
    }, i * 80);
  }
  yesBtn.innerHTML = "❤ Sonsuza Dek ❤";
  yesBtn.style.background = 'linear-gradient(135deg, #ff6b9d, #c94f6d)';
  yesBtn.disabled = true;
  yesBtn.style.cursor = 'default';
}

window.onclick = (e) => {
  if (e.target.id === 'lightbox') closeLightbox();
};
</script>

</body>
</html>
